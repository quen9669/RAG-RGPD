# Environnement virtuel créé par uv (se recrée avec `uv sync`)
.venv/

# Caches Python et outils
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets locaux (clés d'API, etc.) : ne jamais les versionner
.env

# Réglages personnels de l'éditeur
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Fichiers bruts téléchargés : jamais publiés (le dépôt est public et
# certaines licences, comme celle de la CNPD, interdisent la rediffusion).
# Seul data/manifest.jsonl est versionné.
data/raw/

# Textes extraits et découpés : ils reprennent le contenu des documents
# (dont la CNPD), donc même règle. Ils se reconstruisent avec `rag-chunk`.
data/processed/

# Index de recherche (vecteurs + texte des morceaux) et journal des réponses
# (questions et extraits cités) : même règle, reconstructibles ou personnels.
data/index/
data/logs/

# Fiches de décision, cache des réponses du LLM et tableaux d'essais en lot
# (étape 4 bis) : ils reprennent des extraits des documents, même règle.
data/traces/
data/cache/
data/batches/

# Rapports d'évaluation complets (étape 5) : commentaires du correcteur et
# phrases recopiées reprennent des extraits, même règle. Seuls les scores de
# référence (evals/reference.json, sans aucun texte) sont versionnés.
data/evals/
